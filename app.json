{
  "expo": {
    "name": "SolFocus",
    "slug": "solfocus-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060d12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.techdecorum.solfocus"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060d12"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.techdecorum.solfocus",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4dd9ac",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cefee580-df0e-4408-b057-4bd39211119d"
      }
    }
  }
}
